  "version": "8.0.0",
  "core_update": {
    "changes": [
      "Major native Windows migration scaffold",
      "Add self-contained .NET 8 win-x64 build definition so the target PC does not need Python or a separately installed .NET runtime",
      "Add JARVIS Arduino USB/Serial SDK and protocol",
      "Preserve the existing Python V8 runtime during migration; no destructive replacement"
